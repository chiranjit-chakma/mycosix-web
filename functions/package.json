{
  "name": "mycosix-functions",
  "description": "Trusted backend for MYCOSIX: order creation is server-side only.",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "test": "node --test test/create_order.test.js",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "seed": "node scripts/seed_catalog.js",
    "seed:force": "node scripts/seed_catalog.js --force",
    "seed:dry": "node scripts/seed_catalog.js --dry-run"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.0"
  }
}
