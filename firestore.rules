rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // An administrator is anyone whose uid has a document in the `admins`
    // collection. This is decided server-side by the rules engine on every
    // request - never by a client-side flag.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The canonical statuses an order document may hold. Mirrors
    // OrderStatus.label / orderStatusLabels in the app and the constants in the
    // trusted order backend. A stored status is always one of these exact
    // strings - never a Dart enum name or a free-form value.
    function isOrderStatus(status) {
      return status in [
        'New', 'Contacted', 'Confirmed', 'Preparing',
        'Out for Delivery', 'Delivered', 'Cancelled'
      ];
    }

    // Canonical labels for the admin-only production-data collections. They
    // mirror the Dart label allowlists in the models (batch.dart,
    // order_request.dart, inventory_movement.dart). A stored value is always
    // one of these exact strings - never a Dart enum name or free-form text.
    function isBatchStatus(status) {
      return status in [
        'Planned', 'In Production', 'Harvested', 'Closed'
      ];
    }
    function isRequestType(type) {
      return type in [
        'Cancellation', 'Quantity Change', 'Product Change',
        'Delivery Correction', 'Assistance'
      ];
    }
    function isRequestStatus(status) {
      return status in [
        'Pending', 'Approved', 'Rejected', 'Resolved', 'Expired'
      ];
    }
    function isMovementType(type) {
      return type in ['Adjustment', 'Sale'];
    }

    // A browser-captured order. This is the ONLY shape any client may create in
    // /orders: status pinned to 'New', verified pinned to false, and a strict
    // key allowlist. A captured order records the exact amounts the customer saw
    // and agreed at checkout (subtotal/deliveryFee/total/currency) purely as
    // reference money, so a capture an admin later marks Delivered counts into
    // admin revenue; the values are bounded here so a manipulated browser can
    // never write an unbounded or negative total. Rules have no loops, so
    // per-item money (unitPrice/lineTotal) is bounded only by the item count
    // (max 30) and is reviewed by an admin before packing - money is confirmed
    // with the customer on the phone by the admin workflow. A captured order can
    // never change its own status or stamp its own delivery: those fields are
    // admin-only (see the update diff on /orders).
    function isCapturedOrderShape(res) {
      return res.data.keys().hasOnly([
        'orderId', 'customerName', 'phone', 'email',
        'latitude', 'longitude', 'mapsUrl',
        'building', 'apartment', 'landmark', 'instructions',
        'customerId', 'phoneVerified',
        'items', 'status', 'verified', 'createdAt',
        'subtotal', 'deliveryFee', 'total', 'currency'
      ])
      && res.data.status == 'New'
      && res.data.verified == false
      && 'orderId' in res.data
      && res.data.orderId is string
      && res.data.orderId.size() <= 14
      && res.data.orderId.matches('^MYC-[A-HJ-NP-Z2-9]{8}$')
      && 'customerName' in res.data
      && res.data.customerName is string
      && res.data.customerName.size() >= 1
      && res.data.customerName.size() <= 120
      // Contact phone: canonical '+91XXXXXXXXXX', marked phoneVerified. WHO
      // proves the number is gated separately on the orders create rule
      // (phoneProofOrFallbackHolds below) - the shape here only pins the
      // format and the marker; a browser can never write a number outside
      // the canonical Indian pattern or a raw non-boolean marker.
      && 'phone' in res.data
      && res.data.phone is string
      && res.data.phone.matches('^[+]91[6-9][0-9]{9}$')
      && 'phoneVerified' in res.data
      && res.data.phoneVerified == true
      && 'latitude' in res.data
      && res.data.latitude is number
      && 'longitude' in res.data
      && res.data.longitude is number
      // The location link a capture may carry is pinned to Google's own map
      // hosts - the same allowlist the trusted order backend enforces
      // (MAPS_HOSTS). The checkout only ever stores a link this app builds
      // from a confirmed co-ordinate (google.com/maps?q=...); an empty string
      // is tolerated for legacy pins. Anything else is a crafted link and is
      // denied, because an admin opens an order's location link later and an
      // unconstrained host would plant a phishing page under that tap.
      && 'mapsUrl' in res.data
      && res.data.mapsUrl is string
      && res.data.mapsUrl.size() <= 500
      && (res.data.mapsUrl.size() == 0
        || res.data.mapsUrl.matches('(?i)^https://(www\\.google\\.com/maps([?/].*)?|maps\\.google\\.com/maps([?/].*)?|maps\\.app\\.goo\\.gl/.+|goo\\.gl/maps/.+|(www\\.)?googlemaps\\.com/.+)$'))
      && (!('email' in res.data)
          || (res.data.email is string && res.data.email.size() <= 120))
      && (!('building' in res.data)
          || (res.data.building is string && res.data.building.size() <= 200))
      && (!('apartment' in res.data)
          || (res.data.apartment is string && res.data.apartment.size() <= 200))
      && (!('landmark' in res.data)
          || (res.data.landmark is string && res.data.landmark.size() <= 200))
      && (!('instructions' in res.data)
          || (res.data.instructions is string
              && res.data.instructions.size() <= 500))
      && 'items' in res.data
      && res.data.items is list
      && res.data.items.size() >= 1
      && res.data.items.size() <= 30
      // Reference money the customer was shown and agreed at checkout. Never
      // negative, capped, and total must sit between the product sum and the
      // subtotal + delivery fee the customer saw (slack 1 rupee for rounding).
      && 'subtotal' in res.data
      && res.data.subtotal is number
      && res.data.subtotal >= 0
      && res.data.subtotal <= 1000000
      && 'deliveryFee' in res.data
      && res.data.deliveryFee is number
      && res.data.deliveryFee >= 0
      && res.data.deliveryFee <= 100000
      && 'total' in res.data
      && res.data.total is number
      && res.data.total <= 1100000
      && res.data.total >= res.data.subtotal - 1
      && res.data.total <= res.data.subtotal + res.data.deliveryFee + 1
      && 'currency' in res.data
      && res.data.currency is string
      && res.data.currency.size() <= 8
      && 'createdAt' in res.data
      && res.data.createdAt is timestamp
      // When present, the customer the order is linked to must be the
      // signed-in caller themselves - a customer can never stamp an order
      // with someone else's (or a made-up) account id.
      && (!('customerId' in res.data)
          || (res.data.customerId is string
              && res.data.customerId.size() <= 80
              && request.auth != null
              && res.data.customerId == request.auth.uid));
    }

    // The server-side phone proof for a recorded order: either Firebase's
    // own phone_number claim on the caller's token (the caller verified a
    // one-time code just now), or an admin-verified attestation stored on
    // the customer's own profile document. The attestation fields can ONLY
    // be written by an admin (see the customers update rule), so a customer
    // can never attest themselves or clear an admin's attestation.
    function phoneProofHolds(auth, phone) {
      // Pure boolean expression (matching every other function in this file -
      // the rules language has no statement bodies): the caller's own token
      // claim, or an admin attestation on their own customer profile.
      return auth.token.phone_number == phone
        || (exists(/databases/$(database)/documents/customers/$(auth.uid))
            && get(/databases/$(database)/documents/customers/$(auth.uid)).data.phone == phone
            && get(/databases/$(database)/documents/customers/$(auth.uid)).data.phoneVerified == true);
    }

    // The phone gate on recording an order: the strict server proof (token
    // claim, or an admin attestation on the caller's own profile) - or,
    // while the owner's temporary-code fallback is switched on, the
    // phoneVerified marker the checkout stamps only after the customer
    // entered the published temporary code. Guests can therefore order while
    // the fallback is ON; flipping the flag off restores the strict proof
    // and guests are denied again, with no app change needed.
    function phoneProofOrFallbackHolds(auth, res) {
      return (auth != null && phoneProofHolds(auth, res.data.phone))
        || phoneFallbackOn();
    }

    // Whether the owner's temporary-code fallback is switched on. Read from
    // the same siteConfig/public document the shop front reads at startup
    // (customers read it freely; only admins write it). The exists() guard
    // keeps this safe to evaluate even before the field exists - a missing
    // document or field must read as "fallback off".
    function phoneFallbackOn() {
      return exists(/databases/$(database)/documents/siteConfig/public)
        && get(/databases/$(database)/documents/siteConfig/public).data.whatsappCodeFallback == true;
    }

    // Batch quantities must stay sane server-side: nothing negative and never
    // more sold + waste than produced (a produced=0 batch therefore can have
    // no sales or waste at all).
    function batchNumbersOk(res) {
      return res.data.producedQty is int && res.data.producedQty >= 0
        && res.data.soldQty is int && res.data.soldQty >= 0
        && res.data.wasteQty is int && res.data.wasteQty >= 0
        && res.data.soldQty + res.data.wasteQty <= res.data.producedQty;
    }

    // Live site configuration (the single siteConfig/public document). The
    // customer site reads it at startup for delivery settings; only admins
    // (and the console / admin SDK) may change it.
    match /siteConfig/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && docId == 'public';
    }

    // Product catalogue. The shop reads it; admins manage it. Customer carts
    // never write here.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Real orders are created ONLY by the trusted Cloud Function (admin SDK,
    // which bypasses these rules). While that function is not deployed, the
    // browser may record a captured order (status 'New', verified false) through
    // the allowlist below - the one exception to "the browser never writes
    // orders". A capture stores the reference amounts the customer agreed at
    // checkout (bounded by isCapturedOrder); it can never change its own status
    // or stamp its own delivery, and only an admin can mark it Delivered. Only
    // admins may read orders; nobody may delete them.
    match /orders/{orderId} {
      // Admins read every order. The customer an order is linked to (the
      // account that was signed in at checkout, stamped by customerId) may
      // read their own order for the My Orders view - and never anyone
      // else's. Guest orders carry no customerId, so only the admin workflow
      // ever sees them.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      // Capture requires the full shape AND a phone gate: while the owner's
      // temporary-code fallback (siteConfig/public whatsappCodeFallback) is
      // ON, the checkout's phoneVerified marker - stamped only after the
      // customer entered the published temporary code - is accepted as the
      // proof (guests included). While it is OFF, the strict server proof
      // applies again: token claim or admin attestation, guests denied.
      allow create: if isCapturedOrderShape(request.resource)
        && phoneProofOrFallbackHolds(request.auth, request.resource);
      allow delete: if false;

      allow update: if isAdmin()
        // Only the status and its timestamps may ever differ after creation.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'deliveredAt'])
        // Status must be one of the canonical labels (never a free string).
        && isOrderStatus(request.resource.data.status)
        // Delivered and Cancelled are terminal states - an order cannot be
        // moved back to an earlier status once finished.
        && (resource.data.status != 'Delivered'
            || request.resource.data.status == 'Delivered')
        && (resource.data.status != 'Cancelled'
            || request.resource.data.status == 'Cancelled')
        // Entering Delivered (from any other state) must stamp a fresh
        // deliveredAt timestamp at that moment - it cannot be back-dated by
        // first writing a value while still in an earlier status.
        && (resource.data.status == 'Delivered'
            || request.resource.data.status != 'Delivered'
            || (request.resource.data.deliveredAt is timestamp
                && !('deliveredAt' in resource.data)))
        // Once Delivered, deliveredAt is immutable - the recorded delivery
        // time may never be re-stamped or rewritten.
        && (resource.data.status != 'Delivered'
            || request.resource.data.deliveredAt == resource.data.deliveredAt)
        // deliveredAt may only ever exist on a Delivered order.
        && (request.resource.data.status == 'Delivered'
            || !('deliveredAt' in request.resource.data));
    }

    // There is deliberately NO shared, owner-set or "master" admin code, and
    // therefore no secrets collection at all: every admin code is per-email
    // (adminCodes below), so a code only ever opens the account it was set
    // for and changing it retires the old one immediately. Removing the old
    // secrets/adminGate document and its match block means no client-writable
    // secret exists anywhere in the project for a code to be compared against
    // or leaked from.

    // Per-email admin codes (the per-administrator "secret codes"). Every admin
    // is invited by email with its own code, stored here keyed by the
    // (lowercase) verified email, and no client can ever read a code - the
    // rules engine alone compares a submitted code against the stored one.
    //
    //  * create - any admin may open an invite for any email, or set their own
    //    first code, by writing exactly {code, addedBy, addedAt} (addedBy must
    //    be the writer). Opening an invite grants nothing by itself: the code
    //    only matters once the invitee claims it below.
    //  * update - three narrow cases, each verified here (never client-side):
    //      (A) CLAIM: the invitee takes their invite. Only the owner of the
    //          email may write; the write must carry the exact code that was
    //          set for them (rules compare it - nothing is revealed); and the
    //          only change is stamping their uid (+ grantedAt). An owner who
    //          already claimed (uid == self) may run it again, so a network
    //          hiccup between claim and grant never bricks the invite.
    //      (B) an ADMIN changes their OWN code: only the email's own admin may
    //          write, the only change is {code, updatedAt}, and the update
    //          MUST move updatedAt (a server timestamp, so every real change
    //          does). No old code is required - the admin session is the
    //          proof. Requiring updatedAt is what keeps the two cases apart:
    //          the code entry above submits {code, uid, grantedAt} and never
    //          touches updatedAt, so a code entry can only ever be judged by
    //          case (A) - i.e. against the code stored right now. Without
    //          that, entering a code that is no longer the stored one still
    //          looked like "an admin changing their own code" and was
    //          accepted, which is exactly how an old code kept working after
    //          the owner changed it.
    //      (C) any admin RESETS an invite code that nobody has claimed yet
    //          (!('uid' in the doc)), so a lost invite code can be replaced
    //          before the invitee uses it. Once claimed, only that admin
    //          (case B) may change it.
    //  * delete - never by clients. Revoking an admin is a console action that
    //    removes BOTH the admins/{uid} grant and this adminCodes/{email} row.
    match /adminCodes/{email} {
      allow read: if false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['code', 'addedBy', 'addedAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 64
        && request.resource.data.addedBy == request.auth.uid;
      allow update: if isSignedIn()
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 64
        && (
          (
            email == request.auth.token.email
            && (!('uid' in resource.data)
                || resource.data.uid == request.auth.uid)
            && request.resource.data.code == resource.data.code
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['uid', 'grantedAt'])
          )
          || (
            email == request.auth.token.email
            && isAdmin()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['code', 'updatedAt'])
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasAll(['updatedAt'])
          )
          || (
            isAdmin()
            && !('uid' in resource.data)
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['code', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // Admin grants. A signed-in user may read their own grant (so the app can
    // learn who is an admin), and any admin may read the whole roster (to show
    // the admin list in the Admins manager). A grant is created through ONE
    // door only - an email invite: the write must be the submitter's own uid
    // carrying only {email, addedAt}, email equal to their verified token
    // email, and their uid must already be stamped on adminCodes/<email> -
    // which the invitee did above by claiming the per-email code with the code
    // that was set for their email. The grant doc stays code-free, so no
    // secret ever leaks into the readable roster.
    //
    // There is deliberately no shared or master code, so a code is never a
    // skeleton key: it opens only the account whose email it was set for, and
    // changing that code retires the previous one at once (the claim above
    // compares the submitted code against the stored value, and the stored
    // value is what changed). The security boundary stays server-side: a
    // stranger is still denied unless their OWN email has a code and they
    // submit it. Once the grant exists, the gate opens without any code.
    // Grants are revoked by the owner through the console (delete the
    // admins/{uid} row AND its adminCodes/{email} row) - client
    // updates/deletes stay denied.
    match /admins/{uid} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'addedAt'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && exists(
             /databases/$(database)/documents/adminCodes/$(request.resource.data.email))
        && get(
             /databases/$(database)/documents/adminCodes/$(request.resource.data.email))
             .data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Push-notification registration tokens. Every signed-in user owns exactly
    // their own token list and only they may read or change it - the Cloud
    // Functions notification backend (Admin SDK, which bypasses rules) reads
    // these to deliver pushes and prunes tokens that turn unregistered, but a
    // browser can never read or overwrite someone else's tokens, so FCM tokens
    // stay protected even if a rogue client asks for them.
    match /fcmTokens/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Customer account profiles. A registered customer owns exactly their own
    // document; nobody else can read it (only an admin may, for the admin
    // Customers section). The email on the profile must be the email the
    // auth provider verified for that uid, and a customer document starts
    // life as 'active' - account status changes are an admin-only decision.
    // The other admin-only write is the WhatsApp-number attestation (phone +
    // phoneVerified + who/when): an admin who confirmed the number with the
    // customer may mark it verified so future orders skip the one-time code.
    match /customers/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'createdAt', 'status'
        ])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() <= 120
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 120))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.status == 'active';
      allow update: if
        (
          // The owner may only refresh their display name.
          isSignedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'updatedAt'])
          && (!('displayName' in request.resource.data)
              || (request.resource.data.displayName is string
                  && request.resource.data.displayName.size() <= 120))
        )
        || (
          // An admin may change the account status (active/disabled) and,
          // separately, the WhatsApp-number attestation: the canonical
          // phone the customer uses on the shop, whether an admin verified
          // it with the customer, and who verified it and when. These
          // attestation fields are strictly admin-only - a customer can
          // never write, change or clear their own verification.
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'status', 'updatedAt', 'phone', 'phoneVerified',
                 'phoneVerifiedBy', 'phoneVerifiedAt'
               ])
          && (!('status' in request.resource.data)
              || request.resource.data.status in ['active', 'disabled'])
          && (!('phone' in request.resource.data)
              || (request.resource.data.phone is string
                  && request.resource.data.phone
                       .matches('^[+]91[6-9][0-9]{9}$')))
          && (!('phoneVerified' in request.resource.data)
              || request.resource.data.phoneVerified is bool)
          && (!('phoneVerifiedBy' in request.resource.data)
              || (request.resource.data.phoneVerifiedBy is string
                  && request.resource.data.phoneVerifiedBy.size() <= 120))
          && (!('phoneVerifiedAt' in request.resource.data)
              || request.resource.data.phoneVerifiedAt is timestamp)
        );
      allow delete: if false;
    }

    // Account cart mirror (carts/{uid}). Owner-only: a customer reads and
    // writes exactly their own cart document, nobody else's, and an admin
    // cannot read a customer's cart (it is not business data).
    //
    // The document is {items: map, removed: list-of-ids, updatedAt}. 'removed'
    // is the account-wide REMOVAL-TOMBSTONE list: it is how a removal on one
    // device propagates to the others. Bounded here to 100 ids (the newest 100
    // survive), matching the store's own trim.
    //
    // Per-line quantities cannot be bounded field-by-field here (rules have
    // no iteration), and that is acceptable: only the owner can write their
    // own cart, every value is re-sanitised and re-clamped against the live
    // catalogue on read, and prices/stock are decided exclusively by the
    // order backend at checkout - a tampered cart document buys nothing.
    match /carts/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items', 'removed', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 30
        && (!('removed' in request.resource.data)
          || (request.resource.data.removed is list
            && request.resource.data.removed.size() <= 100));
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Account wishlists (wishlists/{uid}). Owner-only, mirroring carts:
    // a customer reads and writes exactly their own saved-product list and
    // nothing else. The list itself is plain product ids (bounded here), and
    // every id is resolved against the live catalogue when displayed - a
    // tampered or stale entry simply never renders.
    match /wishlists/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 120;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Managed editorial + team records. Anyone may READ (the public marketing
    // pages render the live "Our Team" roster and admin-written copy from these
    // collections), but only an authorized admin may create/update/delete. The
    // admin area writes them through the admin-scoped Firestore app; customer
    // pages read them through the default app.
    match /team/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /content/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Zero-budget admin production data (batches, movements, requests).
    // Every one is admin-only: the public customer site can never read or
    // write them, and no `allow read, write` here is ever open to the world.
    // -----------------------------------------------------------------------

    // Grow batches (MYCO-BATCH-<year>-<seq>). Farm records only, written by
    // the admin Batches section. Never deleted - a batch is a record.
    match /batches/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        // Only the modelled fields may be written, in one allowlist.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'batchId', 'variety', 'productionDate', 'expectedHarvestDate',
          'actualHarvestDate', 'producedQty', 'soldQty', 'wasteQty',
          'grade', 'notes', 'status', 'year', 'createdAt', 'updatedAt'
        ])
        && isBatchStatus(request.resource.data.status)
        && batchNumbersOk(request.resource)
        // A "Harvested" batch must actually have produced something.
        && (request.resource.data.status != 'Harvested'
            || request.resource.data.producedQty > 0)
        && request.resource.data.batchId is string
        && request.resource.data.batchId.matches('^MYCO-BATCH-\\d{4}-\\d{3,}$')
        && request.resource.data.variety is string
        && request.resource.data.variety.size() > 0
        && request.resource.data.variety.size() <= 60
        && request.resource.data.productionDate is string
        && request.resource.data.productionDate.size() <= 10
        && request.resource.data.expectedHarvestDate is string
        && request.resource.data.expectedHarvestDate.size() <= 10
        && (!('actualHarvestDate' in request.resource.data)
            || (request.resource.data.actualHarvestDate is string
                && request.resource.data.actualHarvestDate.size() <= 10))
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 500));
      allow delete: if false;
    }

    // Inventory movement audit trail. Append-only: admins create movements
    // from the Inventory/Products sections; nobody edits or deletes them.
    match /inventoryMovements/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'productId', 'productName', 'movementType', 'previousStock',
          'newStock', 'note', 'linkedOrderId', 'recordedByEmail', 'recordedAt'
        ])
        && isMovementType(request.resource.data.movementType)
        && request.resource.data.previousStock is int
        && request.resource.data.previousStock >= 0
        && request.resource.data.newStock is int
        && request.resource.data.newStock >= 0
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.productId is string
        && request.resource.data.productId.size() <= 80
        && request.resource.data.productName is string
        && request.resource.data.productName.size() <= 120;
      allow update: if false;
      allow delete: if false;
    }

    // Customer requests (cancellation / order change / assistance) recorded by
    // the team. Decisions change ONLY the request's own status + decision
    // fields; they never mutate the linked order (that stays a manual admin
    // step in Orders, mirrored by the rules on /orders).
    match /orderRequests/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'requestType', 'requestDetail', 'status', 'orderId',
          'orderStatusLabel', 'customerName', 'phone', 'recordedByEmail',
          'recordedAt'
        ])
        && isRequestType(request.resource.data.requestType)
        && isRequestStatus(request.resource.data.status)
        && (!('orderStatusLabel' in request.resource.data)
            || isOrderStatus(request.resource.data.orderStatusLabel))
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.requestDetail is string
        && request.resource.data.requestDetail.size() > 0
        && request.resource.data.requestDetail.size() <= 600
        // Customer identity is optional only because a request may be general
        // assistance with no linked order; when present it is plain, bounded text.
        && (!('customerName' in request.resource.data)
            || (request.resource.data.customerName is string
                && request.resource.data.customerName.size() <= 120))
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 30));
      allow update: if isAdmin()
        // Only the decision fields may differ after creation.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'decisionAt', 'decidedByEmail', 'decisionNote', 'updatedAt'
        ])
        && isRequestStatus(request.resource.data.status)
        // Terminal statuses are immutable once reached.
        && !(resource.data.status in ['Resolved', 'Rejected', 'Expired'])
        // A recorded decision is stamped by the server at that moment.
        && (!('decisionAt' in request.resource.data)
            || request.resource.data.decisionAt is timestamp)
        && (!('decisionNote' in request.resource.data)
            || (request.resource.data.decisionNote is string
                && request.resource.data.decisionNote.size() <= 600));
      allow delete: if false;
    }
  }
}
