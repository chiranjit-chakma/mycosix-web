rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // An administrator is anyone whose uid has a document in the `admins`
    // collection. This is decided server-side by the rules engine on every
    // request - never by a client-side flag.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The canonical statuses an order document may hold. Mirrors
    // OrderStatus.label / orderStatusLabels in the app and the constants in the
    // trusted order backend. A stored status is always one of these exact
    // strings - never a Dart enum name or a free-form value.
    function isOrderStatus(status) {
      return status in [
        'New', 'Contacted', 'Confirmed', 'Preparing',
        'Out for Delivery', 'Delivered', 'Cancelled'
      ];
    }

    // Canonical labels for the admin-only production-data collections. They
    // mirror the Dart label allowlists in the models (batch.dart,
    // order_request.dart, inventory_movement.dart). A stored value is always
    // one of these exact strings - never a Dart enum name or free-form text.
    function isBatchStatus(status) {
      return status in [
        'Planned', 'In Production', 'Harvested', 'Closed'
      ];
    }
    function isRequestType(type) {
      return type in [
        'Cancellation', 'Quantity Change', 'Product Change',
        'Delivery Correction', 'Assistance'
      ];
    }
    function isRequestStatus(status) {
      return status in [
        'Pending', 'Approved', 'Rejected', 'Resolved', 'Expired'
      ];
    }
    function isMovementType(type) {
      return type in ['Adjustment', 'Sale'];
    }

    // A browser-captured order. This is the ONLY shape any client may create in
    // /orders: status pinned to 'New', verified pinned to false, and a strict
    // key allowlist with NO money keys (subtotal/deliveryFee/total/unitPrice/
    // lineTotal/currency are simply impossible to write). A manipulated browser
    // can therefore never write a priced order, choose a status, or stamp a
    // delivery. Firestore rules have no loops, so per-item field checks are
    // bounded at the list level here (count + the top-level allowlist); item
    // contents are product ids/names/quantities only and are reviewed by an
    // admin before packing. Money is confirmed with the customer on the phone
    // by the admin workflow, never trusted from this document.
    function isCapturedOrder(res) {
      return res.data.keys().hasOnly([
        'orderId', 'customerName', 'phone', 'email',
        'latitude', 'longitude', 'mapsUrl',
        'building', 'apartment', 'landmark', 'instructions',
        'items', 'status', 'verified', 'createdAt'
      ])
      && res.data.status == 'New'
      && res.data.verified == false
      && 'orderId' in res.data
      && res.data.orderId is string
      && res.data.orderId.size() <= 14
      && res.data.orderId.matches('^MYC-[A-HJ-NP-Z2-9]{8}$')
      && 'customerName' in res.data
      && res.data.customerName is string
      && res.data.customerName.size() >= 1
      && res.data.customerName.size() <= 120
      && 'phone' in res.data
      && res.data.phone is string
      && res.data.phone.size() >= 6
      && res.data.phone.size() <= 20
      && 'latitude' in res.data
      && res.data.latitude is number
      && 'longitude' in res.data
      && res.data.longitude is number
      && 'mapsUrl' in res.data
      && res.data.mapsUrl is string
      && res.data.mapsUrl.size() <= 500
      && (!('email' in res.data)
          || (res.data.email is string && res.data.email.size() <= 120))
      && (!('building' in res.data)
          || (res.data.building is string && res.data.building.size() <= 200))
      && (!('apartment' in res.data)
          || (res.data.apartment is string && res.data.apartment.size() <= 200))
      && (!('landmark' in res.data)
          || (res.data.landmark is string && res.data.landmark.size() <= 200))
      && (!('instructions' in res.data)
          || (res.data.instructions is string
              && res.data.instructions.size() <= 500))
      && 'items' in res.data
      && res.data.items is list
      && res.data.items.size() >= 1
      && res.data.items.size() <= 30
      && 'createdAt' in res.data
      && res.data.createdAt is timestamp;
    }

    // Batch quantities must stay sane server-side: nothing negative and never
    // more sold + waste than produced (a produced=0 batch therefore can have
    // no sales or waste at all).
    function batchNumbersOk(res) {
      return res.data.producedQty is int && res.data.producedQty >= 0
        && res.data.soldQty is int && res.data.soldQty >= 0
        && res.data.wasteQty is int && res.data.wasteQty >= 0
        && res.data.soldQty + res.data.wasteQty <= res.data.producedQty;
    }

    // Live site configuration (the single siteConfig/public document). The
    // customer site reads it at startup for delivery settings; only admins
    // (and the console / admin SDK) may change it.
    match /siteConfig/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && docId == 'public';
    }

    // Product catalogue. The shop reads it; admins manage it. Customer carts
    // never write here.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Real orders are created ONLY by the trusted Cloud Function (admin SDK,
    // which bypasses these rules). While that function is not deployed, the
    // browser may record a strictly money-free captured order (status 'New',
    // verified false) through the allowlist below - the one exception to "the
    // browser never writes orders", and it carries no economics. Only admins
    // may read orders; nobody may delete them.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isCapturedOrder(request.resource);
      allow delete: if false;

      allow update: if isAdmin()
        // Only the status and its timestamps may ever differ after creation.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'deliveredAt'])
        // Status must be one of the canonical labels (never a free string).
        && isOrderStatus(request.resource.data.status)
        // Delivered and Cancelled are terminal states - an order cannot be
        // moved back to an earlier status once finished.
        && (resource.data.status != 'Delivered'
            || request.resource.data.status == 'Delivered')
        && (resource.data.status != 'Cancelled'
            || request.resource.data.status == 'Cancelled')
        // Entering Delivered (from any other state) must stamp a fresh
        // deliveredAt timestamp at that moment - it cannot be back-dated by
        // first writing a value while still in an earlier status.
        && (resource.data.status == 'Delivered'
            || request.resource.data.status != 'Delivered'
            || (request.resource.data.deliveredAt is timestamp
                && !('deliveredAt' in resource.data)))
        // Once Delivered, deliveredAt is immutable - the recorded delivery
        // time may never be re-stamped or rewritten.
        && (resource.data.status != 'Delivered'
            || request.resource.data.deliveredAt == resource.data.deliveredAt)
        // deliveredAt may only ever exist on a Delivered order.
        && (request.resource.data.status == 'Delivered'
            || !('deliveredAt' in request.resource.data));
    }

    // Admin grants. A signed-in user may read their own grant (so the app can
    // learn who is an admin). Grants are provisioned by the project owner
    // through the console or an admin SDK script - never by the app.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Managed editorial + team records. Read and written by admins only; the
    // public marketing site currently ships its own copy, so nothing here is
    // exposed until a future section reads it on purpose.
    match /team/{docId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /content/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Zero-budget admin production data (batches, movements, requests).
    // Every one is admin-only: the public customer site can never read or
    // write them, and no `allow read, write` here is ever open to the world.
    // -----------------------------------------------------------------------

    // Grow batches (MYCO-BATCH-<year>-<seq>). Farm records only, written by
    // the admin Batches section. Never deleted - a batch is a record.
    match /batches/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        // Only the modelled fields may be written, in one allowlist.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'batchId', 'variety', 'productionDate', 'expectedHarvestDate',
          'actualHarvestDate', 'producedQty', 'soldQty', 'wasteQty',
          'grade', 'notes', 'status', 'year', 'createdAt', 'updatedAt'
        ])
        && isBatchStatus(request.resource.data.status)
        && batchNumbersOk(request.resource)
        // A "Harvested" batch must actually have produced something.
        && (request.resource.data.status != 'Harvested'
            || request.resource.data.producedQty > 0)
        && request.resource.data.batchId is string
        && request.resource.data.batchId.matches('^MYCO-BATCH-\\d{4}-\\d{3,}$')
        && request.resource.data.variety is string
        && request.resource.data.variety.size() > 0
        && request.resource.data.variety.size() <= 60
        && request.resource.data.productionDate is string
        && request.resource.data.productionDate.size() <= 10
        && request.resource.data.expectedHarvestDate is string
        && request.resource.data.expectedHarvestDate.size() <= 10
        && (!('actualHarvestDate' in request.resource.data)
            || (request.resource.data.actualHarvestDate is string
                && request.resource.data.actualHarvestDate.size() <= 10))
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 500));
      allow delete: if false;
    }

    // Inventory movement audit trail. Append-only: admins create movements
    // from the Inventory/Products sections; nobody edits or deletes them.
    match /inventoryMovements/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'productId', 'productName', 'movementType', 'previousStock',
          'newStock', 'note', 'linkedOrderId', 'recordedByEmail', 'recordedAt'
        ])
        && isMovementType(request.resource.data.movementType)
        && request.resource.data.previousStock is int
        && request.resource.data.previousStock >= 0
        && request.resource.data.newStock is int
        && request.resource.data.newStock >= 0
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.productId is string
        && request.resource.data.productId.size() <= 80
        && request.resource.data.productName is string
        && request.resource.data.productName.size() <= 120;
      allow update: if false;
      allow delete: if false;
    }

    // Customer requests (cancellation / order change / assistance) recorded by
    // the team. Decisions change ONLY the request's own status + decision
    // fields; they never mutate the linked order (that stays a manual admin
    // step in Orders, mirrored by the rules on /orders).
    match /orderRequests/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'requestType', 'requestDetail', 'status', 'orderId',
          'orderStatusLabel', 'customerName', 'phone', 'recordedByEmail',
          'recordedAt'
        ])
        && isRequestType(request.resource.data.requestType)
        && isRequestStatus(request.resource.data.status)
        && (!('orderStatusLabel' in request.resource.data)
            || isOrderStatus(request.resource.data.orderStatusLabel))
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.requestDetail is string
        && request.resource.data.requestDetail.size() > 0
        && request.resource.data.requestDetail.size() <= 600
        // Customer identity is optional only because a request may be general
        // assistance with no linked order; when present it is plain, bounded text.
        && (!('customerName' in request.resource.data)
            || (request.resource.data.customerName is string
                && request.resource.data.customerName.size() <= 120))
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 30));
      allow update: if isAdmin()
        // Only the decision fields may differ after creation.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'decisionAt', 'decidedByEmail', 'decisionNote', 'updatedAt'
        ])
        && isRequestStatus(request.resource.data.status)
        // Terminal statuses are immutable once reached.
        && !(resource.data.status in ['Resolved', 'Rejected', 'Expired'])
        // A recorded decision is stamped by the server at that moment.
        && (!('decisionAt' in request.resource.data)
            || request.resource.data.decisionAt is timestamp)
        && (!('decisionNote' in request.resource.data)
            || (request.resource.data.decisionNote is string
                && request.resource.data.decisionNote.size() <= 600));
      allow delete: if false;
    }
  }
}
