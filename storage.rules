rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // MYCOSIX serves product imagery from bundled app assets and public web
    // URLs; the Firebase Storage bucket is not used by the app today.
    // Deny-by-default so nothing here can ever be read or written without an
    // explicit, deliberate rule - none exists yet, and that is the safe state.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
